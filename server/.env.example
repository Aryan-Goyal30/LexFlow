# Copy to server/.env and set your own password. server/.env is ignored by git.
# Keep the password in POSTGRES_PASSWORD and both database URLs the same.

# development | test | production. Sample data can only be loaded in development.
LEXFLOW_ENV=development

# PostgreSQL container (docker compose)
POSTGRES_USER=lexflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lexflow
LEXFLOW_DB_PORT=5432

# Connection strings used by the API, Alembic and the tests
DATABASE_URL=postgresql+psycopg://lexflow:change-me@127.0.0.1:5432/lexflow
TEST_DATABASE_URL=postgresql+psycopg://lexflow:change-me@127.0.0.1:5432/lexflow_test

# Uploaded files (relative paths are relative to server/)
LEXFLOW_UPLOAD_DIR=var/uploads
# 25 MB
LEXFLOW_MAX_UPLOAD_BYTES=26214400

# Calendar used for "today" in date rules and for case-number years
LEXFLOW_TIMEZONE=Asia/Kolkata

# The API refuses to bind to anything but a loopback address
LEXFLOW_API_HOST=127.0.0.1
LEXFLOW_API_PORT=8000

# Sign-in and sessions (Phase 2). The defaults below are what you get if these
# lines are left out.
# Web origins allowed to make changes (JSON list); the Vite dev and preview servers.
# LEXFLOW_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
# A session ends after this long without use, and after this long in any case.
# LEXFLOW_SESSION_IDLE_MINUTES=30
# LEXFLOW_SESSION_ABSOLUTE_HOURS=12
# Secure, __Host- prefixed cookie: required in production (HTTPS only).
# LEXFLOW_COOKIE_SECURE=false
# The 5th consecutive wrong password locks the account for 15 minutes.
# LEXFLOW_LOGIN_MAX_FAILURES=5
# LEXFLOW_LOCKOUT_MINUTES=15
# A temporary password set by an administrator stops working after this long.
# LEXFLOW_TEMPORARY_PASSWORD_HOURS=72

# Document text extraction (Phase 3). The defaults below are what you get if
# these lines are left out. The worker runs each file in a child process that is
# stopped after the timeout; files over the limits fail with the reason.
# LEXFLOW_EXTRACTION_TIMEOUT_SECONDS=120
# LEXFLOW_EXTRACTION_MAX_PAGES=1000
# LEXFLOW_EXTRACTION_MAX_TEXT_BYTES=5000000
# LEXFLOW_EXTRACTION_MAX_UNPACKED_BYTES=200000000
# Chunks: at most this many characters, overlapping by about this many.
# LEXFLOW_CHUNK_SIZE=1200
# LEXFLOW_CHUNK_OVERLAP=200
# The worker: seconds between looks at the queue, how long a claimed job is
# reserved (must be longer than the timeout), and tries before it fails.
# LEXFLOW_WORKER_POLL_SECONDS=2
# LEXFLOW_WORKER_LEASE_SECONDS=300
# LEXFLOW_WORKER_MAX_ATTEMPTS=3
# Embeddings (semantic search): off by default. "local" embeds chunks with
# BAAI/bge-small-en-v1.5 on this computer (nothing is sent elsewhere). It needs
# migration 0009 (a PostgreSQL server with pgvector) and the model files, which
# only `python -m lexflow.cli.models download --confirm` fetches; the worker
# refuses to start with "local" until both are ready.
# LEXFLOW_EMBEDDINGS=disabled
# LEXFLOW_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# LEXFLOW_MODEL_DIR=var/models
# Chunks embedded per model call, and CPU threads the model may use.
# LEXFLOW_EMBEDDING_BATCH_SIZE=16
# LEXFLOW_EMBEDDING_THREADS=2

# AI case analysis (Phase 5): off by default. "gemini" sends the selected case
# text (and any judgment passages) to Google's Gemini API from the server. READ
# docs/adr/0019-ai-case-analysis.md FIRST: the case content leaves this
# computer, Google's terms decide how it is kept, and real client material
# needs a separate privacy, confidentiality and provider-terms review.
# Put the key only in server/.env (never committed, never shown in the app);
# GEMINI_MODEL has no default: choose one from Google's current model list.
# LEXFLOW_AI_PROVIDER=disabled
# Providers: disabled, gemini (real AI), prepared (local demonstration for one
# fictional matter; NOT AI; sends nothing out) and scripted (test double, not
# AI; test and e2e databases only).
# GEMINI_API_KEY=
# GEMINI_MODEL=
# Limits per run, and how many runs one person may start per hour.
# LEXFLOW_AI_TIMEOUT_SECONDS=90
# LEXFLOW_AI_MAX_INPUT_CHARS=60000
# LEXFLOW_AI_MAX_DOCUMENTS=20
# LEXFLOW_AI_MAX_PASSAGES=40
# LEXFLOW_AI_MAX_PRECEDENTS=8
# LEXFLOW_AI_MAX_OUTPUT_TOKENS=16384
# LEXFLOW_AI_RUNS_PER_USER_PER_HOUR=10
# Only sample (fictional) cases may be analysed unless this is true. Leave it
# false until the review above is done.
# LEXFLOW_AI_ALLOW_CLIENT_DATA=false
# Narrower than the flag above: a JSON list of case ids the owner has approved,
# one by one, for analysis by an external provider (and, with migration 0013
# and LEXFLOW_OUTCOME_ASSESSMENT, for outcome assessment). Empty by default.
# LEXFLOW_AI_APPROVED_CASE_IDS=[]

# Outcome assessment (Phase 7): decision support, off by default. The settings
# refuse true unless the database is a test or e2e one (e.g. lexflow_e2e) or
# LEXFLOW_AI_APPROVED_CASE_IDS lists cases; it then applies to those cases only
# and needs migration 0013. The scripted provider is not AI; Gemini is used
# only for an approved case. See docs/PHASE7_PLAN.md and docs/DEMO_GUIDE.md.
# LEXFLOW_OUTCOME_ASSESSMENT=false
