# Front-end settings (optional). Copy to .env.local to change them; .env.local
# is ignored by git. Nothing secret belongs here: VITE_ values reach the browser.

# Where the Vite dev/preview server forwards /api (the LexFlow API).
LEXFLOW_API_PROXY_TARGET=http://127.0.0.1:8000

# Path of the API as seen by the browser. Keep it same-origin.
VITE_API_BASE_URL=/api
